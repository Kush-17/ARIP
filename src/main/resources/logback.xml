<configuration>

    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss} %highlight(%-5level) %cyan([%X{requestId}]) %yellow(%logger{36}) - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>